{
  "$schema": "../.sitecore/schemas/ModuleFile.schema.json",
  "namespace": "Project.krunal",
  "items": {
    "includes": [
      {
        "name": "SyncChunk",
        "path": "/sitecore/content/Applications/Content Editor/Ribbons/Chunks/Sync",
        "scope": "ItemAndDescendants",
        "database": "core"
      },
      {
        "name": "SyncRibbons",
        "path": "/sitecore/content/Applications/Content Editor/Ribbons/Ribbons/Default/SV",
        "scope": "ItemAndDescendants",
        "database": "core"
      },
      {
        "name": "SyncStrips",
        "path": "/sitecore/content/Applications/Content Editor/Ribbons/Strips/Random sync",
        "scope": "ItemAndDescendants",
        "database": "core"
      },
      {
        "name": "templatesFeatureJSSExperienceAccelerator",
        "path": "/sitecore/templates/Feature/JSS Experience Accelerator",
        "scope": "ItemAndDescendants"
      },
      {
        "name": "templatesProject",
        "path": "/sitecore/templates/Project/krunal",
        "allowedPushOperations": "CreateUpdateAndDelete"
      },
      {
        "name": "projectMediaFolders",
        "path": "/sitecore/Media Library/Project/krunal",
        "rules": [
          {
            "path": "/shared",
            "scope": "SingleItem",
            "allowedPushOperations": "CreateOnly"
          },
          {
            "path": "/<SITE_NAME>",
            "scope": "SingleItem",
            "allowedPushOperations": "CreateOnly"
          }
        ]
      },
      {
        "name": "projectRenderings",
        "path": "/sitecore/Layout/Renderings/Project/krunal",
        "scope": "ItemAndDescendants",
        "allowedPushOperations": "CreateUpdateAndDelete"
      },
      {
        "name": "projectPlaceholderSettings",
        "path": "/sitecore/Layout/Placeholder Settings/Project/krunal",
        "allowedPushOperations": "CreateUpdateAndDelete"
      },
      {
        "name": "modules",
        "path": "/sitecore/system/Settings/Project/krunal",
        "allowedPushOperations": "CreateUpdateAndDelete"
      },
      {
        "name": "tenantRoot",
        "path": "/sitecore/content/krunal",
        "scope": "SingleItem",
        "allowedPushOperations": "CreateAndUpdate"
      },
      {
        "name": "site",
        "path": "/sitecore/content/krunal/krunalxmc",
        "rules": [
          {
            "path": "/home",
            "scope": "ItemAndDescendants",
            "allowedPushOperations": "CreateOnly"
          },
          {
            "path": "/Media",
            "scope": "ItemAndChildren",
            "allowedPushOperations": "CreateAndUpdate"
          },
          {
            "path": "/Data",
            "scope": "ItemAndChildren",
            "allowedPushOperations": "CreateAndUpdate"
          },
          {
            "path": "/Dictionary",
            "scope": "ItemAndChildren",
            "allowedPushOperations": "CreateOnly"
          },
          {
            "path": "/Presentation",
            "scope": "ItemAndDescendants",
            "allowedPushOperations": "CreateAndUpdate"
          },
          {
            "path": "/Settings",
            "scope": "ItemAndChildren",
            "allowedPushOperations": "CreateAndUpdate"
          },
          {
            "path": "/Settings/Site Grouping",
            "scope": "ItemAndDescendants",
            "allowedPushOperations": "CreateOnly"
          },
          {
            "path": "*",
            "scope": "Ignored"
          }
        ]
      }
    ]
  }
}
