<?xml version="1.0"?>

<configuration xmlns:patch="http://www.sitecore.net/xmlconfig/">
  <sitecore>	
	  <pipelines>
		  <customPublishPipeline>
			  <processor type="XmCloudSXAStarter.Pipelines.CustomPublishProcessor, XmCloudSXAStarter" />
		  </customPublishPipeline>
	  </pipelines>

	  <events>
		  <event name="publish:end">
			  <handler type="XmCloudSXAStarter.Events.CustomPublishHandler, XmCloudSXAStarter" method="OnPublishEnd"/>
		  </event>
	  </events>
	  
    <commands>
      <command name="sync:random" type="XmCloudSXAStarter.Commands.SyncRandom, XmCloudSXAStarter" />
    </commands>
	  <commands>
		  <command name="custom:clearcache" type="XmCloudSXAStarter.Commands.ClearCacheCommand, XmCloudSXAStarter" />
	  </commands>
  </sitecore>
</configuration>